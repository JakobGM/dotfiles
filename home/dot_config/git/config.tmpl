[user]
    name = Jakob Gerhard Martinussen
    email = jakobgm@gmail.com
    signingkey = ssh-rsa 
[includeIf "gitdir:~/crdbrd/"]
    path = gitconfig-crdbrd
[core]
    editor = nvim
    excludesfile = ~/.config/git/ignore
    pager = delta
[interactive]
    # Delta configuration
    diffFilter = delta --color-only
[add.interactive]
    # Delta configuration
    useBuiltin = false # required for git 2.37.0
[delta]
    # Delta configuration
    # Use n and N to move between diff sections
    navigate = true
    light = false
    syntax-theme = gruvbox-dark
    line-numbers = true
[merge]
    conflictstyle = diff3
[web]
    browser = firefox
[commit]
    gpgsign = true
[tag]
    gpgsign = true
[diff]
    # Delta configuration
    colorMoved = default
[diff.lfs]
    # Show LFS-tracked diffs with bat utility,
    # instead of just showing a pointer to the file.
    textconv = bat
[difftool]
    prompt = false
    trustExitCode = true
[github]
    user = jakobgm
[alias]
    a = forgit add
    b = branch
    c = checkout
    d = diff
    ds = diff --staged
    f = fetch
    fu = forgit fixup
    l = forgit log
    p = push
    pl = pull
    r = restore
    R = !git restore --staged . && git restore .
    rb = forgit rebase
    rc = rebase --continue
    rho = !git fetch origin && git reset --hard @{u} && git clean -df
    rom = rebase -i origin/main
    # Interactively rebase the current gh-stack layer onto the tip of the layer
    # below it, leaving the commits of every layer underneath untouched.
    rs = "!f() { \
        stack=$(gh stack view --json) || exit 1; \
        set -- $(printf '%s' \"$stack\" | jq -r '(.branches | map(.isCurrent) | index(true)) as $i | if $i == null then empty else (if $i == 0 then .trunk else .branches[$i-1].head end) + \" \" + .branches[$i].base end'); \
        [ $# -eq 2 ] || { echo 'git rs: current branch is not part of a gh stack' >&2; exit 1; }; \
        git rebase -i --onto \"$1\" \"$2\"; \
    }; f"
    # Split the current gh-stack layer in two: <sha> and every commit after it
    # move onto a new layer named <github.user>/<suffix>, inserted directly
    # above the current branch. No commit is rewritten, only refs are moved.
    split-stack = "!f() { \
        [ $# -eq 2 ] || { echo 'usage: git split-stack <sha> <new-branch-suffix>' >&2; exit 1; }; \
        git diff --quiet HEAD || { echo 'git split-stack: commit or stash your changes first' >&2; exit 1; }; \
        branch=$(git symbolic-ref --short HEAD) || exit 1; \
        user=$(git config github.user) || { echo 'git split-stack: github.user is not set' >&2; exit 1; }; \
        new=$user/$2; \
        git rev-parse --verify --quiet \"refs/heads/$new\" >/dev/null && { echo \"git split-stack: $new already exists\" >&2; exit 1; }; \
        state=$(git rev-parse --path-format=absolute --git-common-dir)/gh-stack; \
        [ \"$(jq -r .schemaVersion \"$state\" 2>/dev/null)\" = 1 ] || { echo \"git split-stack: no usable gh stack state in $state\" >&2; exit 1; }; \
        below=$(jq -r --arg b \"$branch\" '.stacks[] | select(any(.branches[]; .branch == $b)) | (.branches | map(.branch) | index($b)) as $i | if $i == 0 then .trunk.branch else .branches[$i-1].branch end' \"$state\"); \
        [ -n \"$below\" ] || { echo \"git split-stack: $branch is not part of a gh stack\" >&2; exit 1; }; \
        floor=$(git rev-parse --verify \"$below\") || exit 1; \
        tip=$(git rev-parse HEAD); \
        keep=$(git rev-parse --verify \"$1^{commit}^\") || exit 1; \
        git merge-base --is-ancestor \"$1\" HEAD || { echo \"git split-stack: $1 is not on $branch\" >&2; exit 1; }; \
        [ \"$keep\" != \"$floor\" ] && git merge-base --is-ancestor \"$floor\" \"$keep\" || { echo \"git split-stack: $1 would leave $branch without commits of its own\" >&2; exit 1; }; \
        jq --arg b \"$branch\" --arg new \"$new\" --arg keep \"$keep\" --arg tip \"$tip\" '.stacks |= map(if any(.branches[]; .branch == $b) then .branches |= (map(if .branch == $b then .head = $keep else . end) | . as $bs | ($bs | map(.branch) | index($b)) as $i | $bs[0:$i+1] + [{branch: $new, head: $tip, base: $keep}] + $bs[$i+1:]) else . end)' \"$state\" > \"$state.new\" || exit 1; \
        git branch \"$new\" \"$tip\" && git reset --hard \"$keep\" && mv \"$state.new\" \"$state\" || { rm -f \"$state.new\"; exit 1; }; \
        echo \"$branch now ends at $(git rev-parse --short \"$keep\"), $new carries $(git rev-list --count \"$keep..$tip\") commit(s)\"; \
        echo 'Next: gh stack submit'; \
    }; f"
    s = status
    set-upstream = !git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`
    push-upstream = !git push --set-upstream origin `git symbolic-ref --short HEAD`
[gpg]
  format = ssh
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- else if eq .chezmoi.os "linux" }}
  program = "/opt/1Password/op-ssh-sign"
{{- end }}
# Reset the system helper list and only cache credentials in memory
[credential]
  helper = ""
  helper = cache
# Verify integrity of every object received or sent, rejecting malformed objects
[transfer]
    fsckObjects = true
[pull]
    rebase = true
[push]
    default = current
    gpgSign = if-asked
    followTags = true
[rebase]
    autostash = true
    autosquash = true
[receive]
    advertisePushOptions = true
[color]
    ui = true
[color "diff-highlight"]
    oldNormal = "red bold"
    oldHighlight = "red bold 52"
    newNormal = "green bold"
    newHighlight = "green bold 22"
[color "diff"]
    meta = "yellow"
    frag = "magenta bold"
    commit = "yellow bold"
    old = "red bold"
    new = "green bold"
    whitespace = "red reverse"
[difftool "kitty"]
    cmd = kitty +kitten diff $LOCAL $REMOTE
[difftool "kitty.gui"]
    cmd = kitty kitty +kitten diff $LOCAL $REMOTE
[merge]
    tool = nvim
[mergetool "nvim"]
    cmd = nvim -f -c \"Gvdiffsplit!\" \"$MERGED\"
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
