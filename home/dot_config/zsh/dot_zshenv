# Guard for machines migrating from zsh to fish. Nothing else in this
# directory is managed any more; see .chezmoiremove.
#
# Until the next login, the session started by the old zsh setup still exports
# ZDOTDIR=~/.config/zsh, HISTFILE and SAVEHIST. A zsh started then (e.g. a new
# kitty window) reads only this file, and without the old options it would
# rewrite the history file in the plain format, dropping every timestamp.
# After logging in with fish as the login shell, ZDOTDIR is not set and this
# file is never read.
SAVEHIST=0
unset HISTFILE
