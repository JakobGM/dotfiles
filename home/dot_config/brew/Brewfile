# Curated Brewfile — declares everything these dotfiles assume to be on PATH.
# Run `brew bundle install --file ~/.config/brew/Brewfile` to install missing
# entries; the chezmoi run_onchange hook does this automatically when this file
# changes.

# Shell & terminal
brew "fish"             # interactive login shell (~/.config/fish/)
brew "fisher"           # fish plugin manager; installs forgit from fish_plugins
brew "starship"         # prompt (~/.config/starship.toml)
brew "zoxide"           # `z` directory jumping, initialised in config.fish
brew "atuin"            # shell history search and encrypted sync (~/.config/atuin/)
brew "direnv"           # config.fish hooks direnv into the shell
brew "fzf"              # fuzzy finder; sourced from config.fish and FZF_* env vars
brew "fd"               # FZF_DEFAULT_COMMAND='fd --type file --hidden'
cask "kitty"            # terminal emulator (~/.config/kitty/)

# Editor — track Neovim HEAD/nightly
brew "neovim", args: ["HEAD"]
brew "neovim-remote"    # nvr; VISUAL=nvr when $NVIM_LISTEN_ADDRESS is set
brew "tree-sitter-cli"  # required by nvim-treesitter `main` branch (`tree-sitter build`)
brew "universal-ctags"  # vim-gutentags shells out to this; macOS ships BSD ctags which is incompatible

# Modern unix replacements (referenced from fish/config.fish)
brew "bat"              # cat
brew "eza"              # ls
brew "ripgrep"          # rg; also referenced from MANPAGER and completions
brew "git-delta"        # delta; git's [core] pager

# Toolchains
brew "mise"             # runtime/version manager
brew "uv"               # python package manager (used by nvim venv setup)
brew "pre-commit"       # personal pre-commit hooks (per ~/.config/git/ignore)

# Git
brew "gh"               # GitHub CLI; gh-copilot wraps it
brew "git-lfs"          # filter "lfs" in ~/.config/git/config + .gitattributes
brew "jq"               # `git rs` parses `gh stack view --json` with it

# GPG / signing
brew "gnupg"            # gpg2; SECRETS_GPG_COMMAND, fallback commit signing
brew "pinentry"         # pinentry-tty; referenced from gpg-agent.conf

# Secrets / 1Password
cask "1password-cli"    # op; chezmoi onepasswordRead in wakatime template
cask "1password"        # GUI app provides op-ssh-sign + the ssh-agent socket

# Browser (for tridactyl)
cask "firefox"          # tridactyl runs as a Firefox extension

# Cloud
cask "google-cloud-sdk" # gcloud, bq and gsutil (the cask links them into brew's bin)

# Bootstrap (declared for documentation; chezmoi must be installed to clone
# this repo in the first place)
brew "chezmoi"
