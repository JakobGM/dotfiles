# chezmoi's own config. After changing this file, regenerate it with `chezmoi init`.
[onepassword]
    # Inside an SSH session, 1Password asks on the machine you connected from.
    command = "{{ .chezmoi.homeDir }}/.local/bin/op-forwarded"
    # No `op signin` first: op-forwarded reads all secrets with one approval and caches them.
    prompt = false
