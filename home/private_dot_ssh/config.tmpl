Host *
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else if eq .chezmoi.os "linux" }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}

# Own machines, by Tailscale (MagicDNS) name; servers set up with `mise run ssh:server`
Host silver gold oxygen
    User jakobgm
    ForwardAgent yes

# Laptop (macOS)
Host silver
    HostName jakobgm-laptop

# Home desktop
Host gold
    HostName jakobgm-home

# Work desktop
Host oxygen
    HostName jakobgm-work

Host aur.archlinux.org
    IdentityFile ~/.ssh/aur
    User aur

Host github.com
    User git

    ControlMaster auto
    ControlPath ~/.ssh/connections/%r@%h:%p
    ControlPersist 12h
