# 1Password is the agent, except inside an SSH session: there the agent forwarded by
# `ssh -A`/ForwardAgent (SSH_AUTH_SOCK) is used, so 1Password asks on the machine you connect from.
Match !exec "printenv SSH_CONNECTION >/dev/null"
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else if eq .chezmoi.os "linux" }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}

# Own machines, by Tailscale (MagicDNS) name: jakobgm-laptop (MacBook), jakobgm-laptop-2023
# (backup Arch laptop), jakobgm-home and jakobgm-work; servers set up with
# `mise run ssh:server`. The Linux machines' hostnames are aliases.
Host jakobgm-laptop jakobgm-laptop-2023 jakobgm-home jakobgm-work silver gold oxygen
    User jakobgm
    ForwardAgent yes

Host silver
    HostName jakobgm-laptop-2023

Host gold
    HostName jakobgm-home

Host oxygen
    HostName jakobgm-work

Host aur.archlinux.org
    IdentityFile ~/.ssh/aur
    User aur

Host github.com
    User git

    ControlMaster auto
    ControlPath ~/.ssh/connections/%r@%h:%p
    ControlPersist 8h
