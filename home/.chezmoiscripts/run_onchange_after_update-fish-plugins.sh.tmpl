#!/usr/bin/env bash
# Install/remove fish plugins whenever fish_plugins changes.
# fish_plugins sha256: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
set -euo pipefail
if command -v fish >/dev/null && fish -c 'type -q fisher'; then
    fish -c 'fisher update'
else
    echo "update-fish-plugins: fish or fisher missing, skipping" >&2
fi
