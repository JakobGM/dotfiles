{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
#!/usr/bin/env bash
# Re-runs whenever this script's content changes.
set -euo pipefail
packages=(
    # inotifywait is Neovim's LSP file watcher backend on Linux (macOS uses FSEvents)
    inotify-tools
    # ssh client, and sshd for `mise run ssh:server`
    openssh
    # interactive login shell (~/.config/fish/)
    fish
    # fish plugin manager; installs forgit from ~/.config/fish/fish_plugins
    fisher
    # prompt (~/.config/starship.toml)
    starship
    # `z` directory jumping, initialised in config.fish
    zoxide
    # shell history search and encrypted sync (~/.config/atuin/)
    atuin
    # idle daemon that locks the screen (exec'd from ~/.config/sway/config)
    swayidle
    # zsh stays installed for the *.zsh scripts sway, waybar and kitty run
    zsh
    # CLI spec tool; mise needs it for shell completions
    usage
)
sudo pacman -S --needed --noconfirm "${packages[@]}"
{{- end -}}
